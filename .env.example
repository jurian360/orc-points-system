# Copy to .env.local for local development. Never commit the filled-in file.
# In production these are set in Coolify -> Environment Variables.

# Full MongoDB connection string, including a database name.
# Use a least-privilege user with readWrite on this database only — not root.
MONGODB_URI=mongodb://user:password@host:27017/orc-points-system?authSource=admin

# Secret used to sign session cookies. At least 32 characters.
# Generate with:  node scripts/generate-secret.mjs
# Changing this invalidates every issued session (force-logout for all users).
SESSION_SECRET=

# The recovery admin: the way back into the app when every admin account has
# forgotten its password. It has no record in the database, so nothing in the
# app can delete it, demote it or lock it out — and it survives a restored
# backup. The accounts officials use day to day are added on the /users page.
#
# The username is free to choose; it defaults to "admin" when left out. Do not
# give a database account the same username — the app refuses that, because two
# accounts answering to one name would make a login ambiguous.
ADMIN_USERNAME=admin

# scrypt hash of the recovery admin's password, as "<saltHex>:<hashHex>".
# Generate with:  node scripts/hash-password.mjs 'your-password'
# The plaintext password is never stored, here or in source.
ADMIN_PASSWORD_HASH=

# Read as ADMIN_PASSWORD_HASH when that one is not set: the single shared
# password this app had before it had accounts. Deployments that predate the
# accounts keep working on it; new ones should set ADMIN_PASSWORD_HASH instead.
# APP_PASSWORD_HASH=
