# Copy to .env.local for local development. Never commit the filled-in file.
# In production these are set in Coolify -> Environment Variables.

# Full MongoDB connection string, including a database name.
# Use a least-privilege user with readWrite on this database only — not root.
MONGODB_URI=mongodb://user:password@host:27017/orc-points-system?authSource=admin

# Secret used to sign session cookies. At least 32 characters.
# Generate with:  node scripts/generate-secret.mjs
# Changing this invalidates every issued session (force-logout for all users).
SESSION_SECRET=

# scrypt hash of the application password, as "<saltHex>:<hashHex>".
# Generate with:  node scripts/hash-password.mjs 'your-password'
# The plaintext password is never stored, here or in source.
APP_PASSWORD_HASH=
