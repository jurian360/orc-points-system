# Copy to .env.offline for docker-compose.offline.yml. Never commit the filled-in file.

# At least 32 characters. Generate with:  node scripts/generate-secret.mjs
SESSION_SECRET=

# The admin you sign in with on the laptop. It needs no database record, so
# the laptop works from the first start. Generate the hash with:
#   node scripts/hash-password.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
